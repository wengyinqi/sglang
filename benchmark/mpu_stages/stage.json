    "mpu": {
      "server_args": ["--enable-hisparse"],
      "hisparse_config": {
        "top_k": 512, "device_buffer_size": 1024,
        "host_to_device_ratio": 2, "swap_in_block_size": 960, "backing_store": "mpu",
