{
  "schema_version": 1,
  "id": "01-qwen-quest-1gpu-0mpu",
  "family": "qwen",
  "tp_size": 1,
  "default_model": "Qwen/Qwen3-30B-A3B-Thinking-2507",
  "default_revision": "144afc2f379b542fdd4e85a1fcd5e1f79112d95d",
  "variant": "cpu",
  "selector": "quest",
  "physical_budget_exact": true,
  "gpu_memory_ledger": "qwen_quest_v1",
  "hbm_preserves_selector": true,
  "capacity_padding_slots": 1,
  "sparse_context_multiplier": 1,
  "page_size": 64,
  "server_args": [
    "--dtype", "bfloat16", "--kv-cache-dtype", "bfloat16", "--page-size", "64",
    "--base-gpu-id", "0"
  ],
  "variants": {
    "cpu": {
      "server_args": [
        "--enable-hisparse", "--prefill-attention-backend", "flashinfer",
        "--decode-attention-backend", "flashinfer_hisparse"
      ],
      "hisparse_config": {
        "algorithm": "quest", "top_k": 2048, "device_buffer_size": 4096,
        "quest_page_size": 64, "backing_store": "cpu"
      },
      "ratio_key": "host_to_device_ratio"
    },
    "mpu": {
      "server_args": [
        "--enable-hisparse", "--prefill-attention-backend", "flashinfer",
        "--decode-attention-backend", "flashinfer_hisparse"
      ],
      "hisparse_config": {
        "algorithm": "quest", "top_k": 2048, "device_buffer_size": 4096,
        "quest_page_size": 64, "host_to_device_ratio": 2, "backing_store": "mpu",
        "mpu_device_ids": [1], "mpu_memory_reserve_bytes": 1073741824
      },
      "ratio_key": "mpu_capacity_ratio"
    },
    "hbm": {
      "server_args": ["--attention-backend", "flashinfer_quest"],
      "hisparse_config": {"algorithm": "quest", "top_k": 2048, "quest_page_size": 64}
    }
  },
  "defaults": {
    "input_lens": [8192, 32768],
    "output_len": 256,
    "correctness_output_len": 80,
    "concurrencies": [1, 2, 4, 8],
    "num_prompts": 32,
    "repeats": 3,
    "max_total_tokens": 65536,
    "chunked_prefill_size": 8192,
    "mem_fraction_static": 0.8,
    "capacity_ratios": [2],
    "cpu_capacity_ratio": 2
  }
}
